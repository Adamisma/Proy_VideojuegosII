[gd_scene load_steps=2 format=3 uid="uid://cah_fx_attack_wave"]

[sub_resource type="GDScript" id="GDScript_wave"]
script/source = "extends Node2D

@export var duration: float = 0.20
var progress: float = 0.0

func setup(direction: float) -> void:
	scale.x = direction

func _ready() -> void:
	var tween := create_tween()
	tween.tween_property(self, \"progress\", 1.0, duration).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tween.parallel().tween_property(self, \"modulate:a\", 0.0, duration).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	tween.tween_callback(queue_free)

func _process(_delta: float) -> void:
	queue_redraw()

func _draw() -> void:
	var points: PackedVector2Array = PackedVector2Array()
	var start_angle: float = -PI / 2.7
	var end_angle: float = PI / 2.7
	var steps: int = 16
	var base_radius: float = 32.0 + progress * 24.0

	for i in range(steps + 1):
		var t: float = float(i) / float(steps)
		var angle: float = lerp(start_angle, end_angle, t)
		var r: float = base_radius * (1.0 - 0.22 * pow((t - 0.5) * 2.0, 2))
		points.append(Vector2(cos(angle) * r, sin(angle) * (r * 0.9)))

	if points.size() > 1:
		# Resplandor exterior dorado inca
		draw_polyline(points, Color(1.0, 0.75, 0.15, 0.55), 9.0, true)
		# Trazo medio amarillo brillante
		draw_polyline(points, Color(1.0, 0.92, 0.3, 0.9), 5.0, true)
		# Núcleo blanco-dorado intenso
		draw_polyline(points, Color(1.0, 1.0, 0.85, 0.98), 2.2, true)
"

[node name="FXAttackWave" type="Node2D"]
script = SubResource("GDScript_wave")

[node name="Sparks" type="CPUParticles2D" parent="."]
emitting = true
amount = 8
lifetime = 0.22
one_shot = true
explosiveness = 0.85
spread = 35.0
gravity = Vector2(0, 40)
initial_velocity_min = 80.0
initial_velocity_max = 140.0
scale_amount_min = 2.0
scale_amount_max = 3.5
color = Color(1, 0.88, 0.2, 0.9)
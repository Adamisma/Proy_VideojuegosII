[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_hud"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="MarginContainer" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 18

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="TopBar" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="HealthLabel" type="Label" parent="MarginContainer/VBoxContainer/TopBar"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Salud: 100 / 100"

[node name="HealthBar" type="ProgressBar" parent="MarginContainer/VBoxContainer/TopBar"]
custom_minimum_size = Vector2(240, 24)
layout_mode = 2
size_flags_vertical = 4
max_value = 100.0
value = 100.0
show_percentage = false

[node name="Spacer" type="Control" parent="MarginContainer/VBoxContainer/TopBar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="KillsLabel" type="Label" parent="MarginContainer/VBoxContainer/TopBar"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Enemigos Derrotados: 0"

[node name="ObjectiveLabel" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.3, 1)
theme_override_font_sizes/font_size = 16
text = "🌅 Objetivo: Atraviesa Sacsayhuamán y recupera la Reliquia Ancestral"

[node name="ControlsHint" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 0.8)
theme_override_font_sizes/font_size = 13
text = "Controles: [A/D] Mover | [Espacio] Saltar | [Shift] Dash | [J / Click Izq.] Atacar | [K / Click Der.] Disparo (HU04)"

[node name="GameOverPanel" type="PanelContainer" parent="."]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -140.0
offset_right = 220.0
offset_bottom = 140.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="GameOverPanel"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Title" type="Label" parent="GameOverPanel/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.2, 0.2, 1)
theme_override_font_sizes/font_size = 28
text = "¡HAS SIDO DERROTADO!"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="GameOverPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "Cahuide cayó en la batalla de Sacsayhuamán.
Presiona [R] para volver a intentarlo."
horizontal_alignment = 1

[node name="HBoxContainer" type="HBoxContainer" parent="GameOverPanel/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="BtnRestart" type="Button" parent="GameOverPanel/VBoxContainer/HBoxContainer"]
custom_minimum_size = Vector2(140, 40)
layout_mode = 2
text = "Reintentar"

[node name="BtnMenu" type="Button" parent="GameOverPanel/VBoxContainer/HBoxContainer"]
custom_minimum_size = Vector2(140, 40)
layout_mode = 2
text = "Menú Principal"

[node name="VictoryPanel" type="PanelContainer" parent="."]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -240.0
offset_top = -150.0
offset_right = 240.0
offset_bottom = 150.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="VictoryPanel"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Title" type="Label" parent="VictoryPanel/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.2, 1)
theme_override_font_sizes/font_size = 28
text = "¡VICTORIA EN SACSAYHUAMÁN!"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="VictoryPanel/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "¡Has recuperado la Reliquia Ancestral!
El Poder del Sol ha sido despertado para la resistencia."
horizontal_alignment = 1

[node name="HBoxContainer" type="HBoxContainer" parent="VictoryPanel/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="BtnVictoryRestart" type="Button" parent="VictoryPanel/VBoxContainer/HBoxContainer"]
custom_minimum_size = Vector2(140, 40)
layout_mode = 2
text = "Jugar de Nuevo"

[node name="BtnVictoryMenu" type="Button" parent="VictoryPanel/VBoxContainer/HBoxContainer"]
custom_minimum_size = Vector2(140, 40)
layout_mode = 2
text = "Menú Principal"
